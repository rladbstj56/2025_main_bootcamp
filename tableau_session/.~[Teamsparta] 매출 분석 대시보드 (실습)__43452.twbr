    <worksheet name='지역별'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>Default Title</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>주소 바탕으로 시도/시군구 구하기</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='12'>•C_시도</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>= SPLIT( </run>
            <run fontcolor='#ed7d31' fontsize='12'>[주소]</run>
            <run fontcolor='#000000' fontsize='12'> , &quot; &quot;, 1) </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='12'>•C_시군구</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='12'>= SPLIT( </run>
            <run fontcolor='#ed7d31' fontsize='12'>[주소]</run>
            <run fontcolor='#000000' fontsize='12'> , &quot; &quot;, 2)</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='KRSuperstore_Sample' name='federated.1gju0w90c7lco11f6pf8i0o9lyqn' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1gju0w90c7lco11f6pf8i0o9lyqn'>
